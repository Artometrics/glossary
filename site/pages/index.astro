---
import Base from "../layouts/Base.astro";
import { entries } from "../data/entries";
import { styles } from "../data/styles";
import { KIND_LABEL } from "../data/types";

const orderedEntries = [...entries].sort((a, b) =>
  a.sortName.localeCompare(b.sortName, "en", { sensitivity: "base" }),
);
const orderedStyles = [...styles].sort((a, b) =>
  a.title.localeCompare(b.title, "en", { sensitivity: "base" }),
);
---

<Base
  title="Artometrics Glossary"
  description="An encyclopedia and a style board: expert, modern-context entries for people and events, and visual languages with starter files."
  path="/"
>
  <div class="report report--wide glossary">
    <header class="home-hero">
      <p class="product-kicker">Glossary</p>
      <h1>The encyclopedia of looking.</h1>
      <p class="lede">
        People, figures, events, and styles — written as a modern-context reading, not a résumé.
        Each encyclopedia entry is what an expert would actually tell you: the mechanism, the life
        that formed the work, and what the sources will and will not support. The style board names
        a visual language and hands you a history, the defining works, and files an agent can take
        from here.
      </p>
    </header>

    <div class="section-head">
      <h2>Encyclopedia</h2>
      <a href="/encyclopedia">A–Z index</a>
    </div>
    <div class="card-grid">
      {
        orderedEntries.map((entry) => (
          <a class="teaser" href={`/encyclopedia/${entry.slug}`}>
            <span class="teaser__kind">{KIND_LABEL[entry.kind]}</span>
            <h3>{entry.title}</h3>
            <p class="teaser__meta">{entry.dates}</p>
            <p>{entry.dek}</p>
          </a>
        ))
      }
    </div>

    <div class="section-head">
      <h2>Style board</h2>
      <a href="/styles">Browse the board</a>
    </div>
    <div class="card-grid">
      {
        orderedStyles.map((style) => (
          <a class="teaser" href={`/styles/${style.slug}`}>
            <span class="teaser__kind">Style</span>
            <h3>{style.title}</h3>
            <p class="teaser__meta">{style.dates}</p>
            <p>{style.dek}</p>
          </a>
        ))
      }
    </div>

    <div class="section-head">
      <h2>Questions</h2>
      <a href="/questions">What people ask</a>
    </div>
    <p class="lede">
      Short answers to the questions the entries keep getting — the ear, the night watch, the
      inventions that were not inventions. The paragraph says when it is a reading.
    </p>
  </div>
</Base>
