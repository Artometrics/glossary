---
import { TAGLINE } from "@/lib/tagline.mjs";
import { FOOTER_PRIMARY } from "@/lib/site.mjs";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <a class="site-footer__mark" href="/">Artometrics</a>
    <p class="site-footer__tagline">{TAGLINE}</p>
    <nav class="site-footer__links" aria-label="Footer">
      {FOOTER_PRIMARY.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <p class="site-footer__base">
      © {year} Artometrics
      <span aria-hidden="true"> · </span>
      <a href="https://artometrics.com/about">About</a>
      <span aria-hidden="true"> · </span>
      <a href="https://artometrics.com">Magazine</a>
    </p>
  </div>
</footer>
